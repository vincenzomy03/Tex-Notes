  {
    "id": "math-align",
    "name": "Equazioni Allineate (align*)",
    "category": "matematica",
    "command": "\\begin{align*}\n  f(x) &= (x+1)^2 \\\\\n       &= x^2 + 2x + 1\n\\end{align*}",
    "insertText": "\\begin{align*}\n  ${1:f(x)} &= ${2:(x+1)^2} \\\\\n            &= ${3:x^2 + 2x + 1}\n\\end{align*}",
