    "insertText": "\\documentclass[11pt,a4paper]{article}\n",
    "description": "Definisce il tipo di documento (article, report, book) e le opzioni base di impaginazione.",
    "syntax": "\\documentclass[opzioni]{classe}",
    "example": "\\documentclass[12pt,a4paper]{article}",
    "preview": "Imposta margini, corpo del font predefinito e layout base del documento.",
    "keywords": ["documentclass", "classe", "inizio", "documento", "articolo", "impostazione", "preambolo"]
  },
  {
