{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tex-Notes",
  "version": "1.0.0",
  "identifier": "com.texnotes.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tex-Notes - Offline LaTeX Editor",
        "width": 1280,
        "height": 820,
        "minWidth": 850,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
